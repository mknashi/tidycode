# Cloudflare Pages redirect rules
# Static HTML pages should be served directly, not routed through the SPA
# More specific routes MUST come before catch-all /*

# Web app redirect (temporary until /app becomes the actual app route)
/app /                      302

# Serve static HTML files without .html extension
/private-alpha /private-alpha.html    200
/download /download.html         200
/download-alpha /download-alpha.html   200

# Documentation pages
/docs /docs/index.html       200

# SEO landing pages (must come before catch-all)
/json-formatter /json-formatter/index.html  200
/json-formatter/ /json-formatter/index.html 200
/xml-formatter /xml-formatter/index.html    200
/xml-formatter/ /xml-formatter/index.html   200
/json-editor /json-editor/index.html        200
/json-editor/ /json-editor/index.html       200
/xml-editor /xml-editor/index.html          200
/xml-editor/ /xml-editor/index.html         200
/yaml-editor /yaml-editor/index.html        200
/yaml-editor/ /yaml-editor/index.html       200
/toml-editor /toml-editor/index.html        200
/toml-editor/ /toml-editor/index.html       200
/csv-editor /csv-editor/index.html          200
/csv-editor/ /csv-editor/index.html         200
/markdown-editor /markdown-editor/index.html  200
/markdown-editor/ /markdown-editor/index.html 200
/diff-viewer /diff-viewer/index.html        200
/diff-viewer/ /diff-viewer/index.html       200
/vim-editor /vim-editor/index.html          200
/vim-editor/ /vim-editor/index.html         200

# All other routes should go to the SPA (index.html) for client-side routing
/* /index.html            200
